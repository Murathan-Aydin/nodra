NODRA_ENV=development
NODRA_ADDR=:8000
NODRA_DATABASE_URL=postgres://nodra:nodra@localhost:5433/nodra?sslmode=disable
# openssl rand -base64 32
NODRA_APP_KEY=
# true uniquement si Nodra est derrière un reverse proxy de confiance
NODRA_TRUST_PROXY=false
# dossier de travail sur les serveurs gérés (applications, bases, services, sauvegardes)
NODRA_SERVER_DATA_DIR=/data/nodra
# URL publique (liens des e-mails et notifications) tant que le domaine de l'instance n'est pas réglé
NODRA_PUBLIC_URL=http://localhost:8000
# origines supplémentaires autorisées pour les WebSocket (front Vite en développement), séparées par des virgules
NODRA_ALLOWED_ORIGINS=localhost:5173
